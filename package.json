{
  "name": "manthra",
  "version": "0.7.1",
  "description": "AI coding assistant CLI with multi-provider support",
  "type": "module",
  "bin": {
    "manthra": "./bin/manthra.js"
  },
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/inline-assets.mjs",
    "build:dist": "npm run build:assets && bash scripts/build-dist.sh",
    "deploy": "bash scripts/deploy.sh",
    "dev": "tsx src/cli/main.ts",
    "dev:web": "tsx src/web/start.ts",
    "start": "node dist/cli/main.js",
    "start:web": "node dist/web/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "postinstall": "chmod +x bin/manthra.js 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.31.0",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fast-glob": "^3.3.2",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "openai": "^4.67.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "into-stream": "6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.7.0",
    "@types/open": "^6.1.0",
    "@yao-pkg/pkg": "^6.19.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
